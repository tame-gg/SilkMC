diff --git a/net/minecraft/server/commands/TeamCommand.java b/net/minecraft/server/commands/TeamCommand.java
index b9c04e559db8352def5f6d73a5f7532e7cce9e0e..bcf683b4aadf52a09c64666ceadccde94cd399bb 100644
--- a/net/minecraft/server/commands/TeamCommand.java
+++ b/net/minecraft/server/commands/TeamCommand.java
@@ -437,11 +437,20 @@ public class TeamCommand {
 
     private static int createTeam(final CommandSourceStack source, final String name, final Component displayName) throws CommandSyntaxException {
         Scoreboard scoreboard = source.getServer().getScoreboard();
-        if (scoreboard.getPlayerTeam(name) != null) {
+        // SilkMC start - region threading - two /team add for the same name can execute on different
+        // region threads at once. Vanilla relies on a single command thread for this check-then-create;
+        // here both callers could pass the null check and both report success, with the loser silently
+        // configuring the winner's team. Taking the scoreboard's existing write lock (the same one
+        // addPlayerTeam uses) restores the vanilla outcome: exactly one creates, the other errors.
+        // This is a command path, not a criteria hot path, so it adds no per-tick contention.
+        final PlayerTeam created = scoreboard.silk$writeLocked(() ->
+            scoreboard.getPlayerTeam(name) != null ? null : scoreboard.addPlayerTeam(name)
+        );
+        if (created == null) {
             throw ERROR_TEAM_ALREADY_EXISTS.create();
         }
-
-        PlayerTeam team = scoreboard.addPlayerTeam(name);
+        PlayerTeam team = created;
+        // SilkMC end - region threading
         team.setDisplayName(displayName);
         source.sendSuccess(() -> Component.translatable("commands.team.add.success", team.getFormattedDisplayName()), true);
         return scoreboard.getPlayerTeams().size();
