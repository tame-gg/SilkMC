diff --git a/gg/tame/silkmc/server/command/RegionScopedScoreHolders.java b/gg/tame/silkmc/server/command/RegionScopedScoreHolders.java
index ea60c06382bf3182e096a0e6c6195e2b8aeda9f6..9439c400c97a216ff6aa06cdacc99fd721276c34 100644
--- a/gg/tame/silkmc/server/command/RegionScopedScoreHolders.java
+++ b/gg/tame/silkmc/server/command/RegionScopedScoreHolders.java
@@ -38,6 +38,66 @@ public final class RegionScopedScoreHolders {
     private RegionScopedScoreHolders() {
     }
 
+    /**
+     * Filters a resolved entity selection down to the entities the calling thread owns.
+     *
+     * <p>Used by commands that read or mutate entity state directly ({@code /tag}), where
+     * {@link net.minecraft.commands.arguments.EntityArgument} has resolved targets across every
+     * region. Unlike {@link #filterToRegion}, every element here is a live entity, so nothing is
+     * exempt: an entity this thread does not own may be mid-tick on its own region.
+     *
+     * <p>Shares the reporting and all-out-of-region behaviour of {@link #filterToRegion} so that both
+     * command families behave identically from an operator's point of view.
+     *
+     * @throws CommandSyntaxException if every matched entity is owned by another region
+     */
+    public static <T extends Entity> Collection<T> filterEntitiesToRegion(
+        final CommandSourceStack source,
+        final Collection<T> entities
+    ) throws CommandSyntaxException {
+        List<T> kept = null;
+        int skipped = 0;
+
+        for (final T entity : entities) {
+            if (!TickThread.isTickThreadFor(entity)) {
+                if (kept == null) {
+                    // First rejection: copy everything accepted so far.
+                    kept = new ArrayList<>(entities.size());
+                    for (final T earlier : entities) {
+                        if (earlier == entity) {
+                            break;
+                        }
+                        kept.add(earlier);
+                    }
+                }
+                skipped++;
+            } else if (kept != null) {
+                kept.add(entity);
+            }
+        }
+
+        if (kept == null) {
+            return entities; // nothing was out of region - hand back the original collection
+        }
+
+        if (kept.isEmpty()) {
+            throw ERROR_ALL_OUT_OF_REGION.create();
+        }
+
+        reportSkipped(source, skipped, kept.size());
+        return kept;
+    }
+
+    private static void reportSkipped(final CommandSourceStack source, final int skipped, final int kept) {
+        source.sendSuccess(
+            () -> Component.literal(
+                "Skipped " + skipped + " target" + (skipped == 1 ? "" : "s")
+                    + " owned by other regions; affected " + kept + "."
+            ).withStyle(ChatFormatting.YELLOW),
+            false
+        );
+    }
+
     /**
      * Filters {@code holders} down to those the calling thread may safely touch.
      *
@@ -76,15 +136,7 @@ public final class RegionScopedScoreHolders {
             throw ERROR_ALL_OUT_OF_REGION.create();
         }
 
-        final int skippedCount = skipped;
-        final int keptCount = kept.size();
-        source.sendSuccess(
-            () -> Component.literal(
-                "Skipped " + skippedCount + " target" + (skippedCount == 1 ? "" : "s")
-                    + " owned by other regions; affected " + keptCount + "."
-            ).withStyle(ChatFormatting.YELLOW),
-            false
-        );
+        reportSkipped(source, skipped, kept.size());
         return kept;
     }
 }
