+package gg.tame.silkmc.server.scoreboard;
+
+import java.lang.ref.Reference;
+import java.lang.ref.ReferenceQueue;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.NoSuchElementException;
+import java.util.concurrent.CopyOnWriteArrayList;
+import org.bukkit.craftbukkit.scoreboard.CraftScoreboard;
+
+/**
+ * Thread-safe weak registry of the scoreboards that vanilla criteria updates must be applied to.
+ *
+ * <p>Upstream tracks these in an {@code ArrayList}-backed {@code WeakCollection}, which assumes a
+ * single server thread. Under region threading the collection is iterated from every region thread
+ * (a criteria trigger such as a health or death change walks it) while plugins register new
+ * scoreboards from other threads, so an unsynchronized list would corrupt or throw.
+ *
+ * <p>Registration is rare and iteration is hot, so this is backed by a copy-on-write list: readers
+ * never block, never allocate and never write. Pruning collected entries is deliberately kept off
+ * that read path. Removing them one at a time as they were encountered would copy the whole backing
+ * array per dead entry, turning a single criteria update after a mass disconnect into a quadratic
+ * walk on a region thread; and every reader doing so would contend on the same write lock. Instead
+ * the garbage collector enqueues cleared references, and {@link #add} drains the queue and removes
+ * the whole batch in one copy. Readers just skip cleared entries.
+ *
+ * <p>Dead entries therefore linger until the next registration. That is bounded by the peak number
+ * of live scoreboards, and skipping one costs a null check.
+ */
+public final class WeakScoreboardSet implements Iterable<CraftScoreboard> {
+    private final List<WeakReference<CraftScoreboard>> entries = new CopyOnWriteArrayList<>();
+    private final ReferenceQueue<CraftScoreboard> collected = new ReferenceQueue<>();
+
+    public void add(final CraftScoreboard scoreboard) {
+        if (scoreboard == null) {
+            throw new IllegalArgumentException("Cannot track a null scoreboard");
+        }
+        this.prune();
+        if (this.contains(scoreboard)) {
+            // Registering twice would apply every criteria update to it twice.
+            return;
+        }
+        this.entries.add(new WeakReference<>(scoreboard, this.collected));
+    }
+
+    private boolean contains(final CraftScoreboard scoreboard) {
+        for (final WeakReference<CraftScoreboard> reference : this.entries) {
+            if (reference.get() == scoreboard) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Drops every reference the collector has cleared, in a single copy of the backing array. */
+    private void prune() {
+        List<Reference<? extends CraftScoreboard>> dead = null;
+        for (Reference<? extends CraftScoreboard> reference; (reference = this.collected.poll()) != null; ) {
+            if (dead == null) {
+                dead = new ArrayList<>();
+            }
+            dead.add(reference);
+        }
+        if (dead != null) {
+            this.entries.removeAll(dead);
+        }
+    }
+
+    @Override
+    public Iterator<CraftScoreboard> iterator() {
+        final Iterator<WeakReference<CraftScoreboard>> backing = this.entries.iterator();
+        return new Iterator<>() {
+            private CraftScoreboard next;
+
+            @Override
+            public boolean hasNext() {
+                while (this.next == null && backing.hasNext()) {
+                    // Collected entries are skipped here and removed by the next add().
+                    this.next = backing.next().get();
+                }
+                return this.next != null;
+            }
+
+            @Override
+            public CraftScoreboard next() {
+                if (!this.hasNext()) {
+                    throw new NoSuchElementException();
+                }
+                final CraftScoreboard scoreboard = this.next;
+                this.next = null;
+                return scoreboard;
+            }
+        };
+    }
+}
