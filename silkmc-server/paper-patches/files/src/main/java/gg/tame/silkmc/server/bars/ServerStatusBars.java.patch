+package gg.tame.silkmc.server.bars;
+
+import ca.spottedleaf.common.time.TickData;
+import io.papermc.paper.threadedregions.RegionizedServer;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegions;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import net.kyori.adventure.bossbar.BossBar;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.format.TextColor;
+import net.kyori.adventure.text.format.TextDecoration;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.entity.Player;
+
+/**
+ * Renders live server-health boss bars for players who opt in through {@code /tpsbar} and
+ * {@code /rambar}. Each bar is toggled independently: the TPS bar shows TPS/MSPT/ping and the
+ * RAM bar shows heap usage. A single shared daemon thread refreshes every tracked player's
+ * active bars once per second, reading region-local tick data where available and falling back
+ * to the global region schedule. This is intended as a lightweight testing/observability aid.
+ */
+public final class ServerStatusBars {
+
+    private static final long REFRESH_INTERVAL_MS = 1000L;
+    private static final double MB = 1024.0D * 1024.0D;
+
+    private static final Map<UUID, BossBar> TPS_BARS = new ConcurrentHashMap<>();
+    private static final Map<UUID, BossBar> RAM_BARS = new ConcurrentHashMap<>();
+    private static volatile Thread updateThread;
+
+    private ServerStatusBars() {
+    }
+
+    /**
+     * Toggles the TPS/MSPT/ping bar for the given player.
+     *
+     * @param player the player to toggle the bar for
+     * @return {@code true} if the bar is now shown, {@code false} if it was hidden
+     */
+    public static boolean toggleTps(final Player player) {
+        final UUID id = player.getUniqueId();
+        final BossBar existing = TPS_BARS.remove(id);
+        if (existing != null) {
+            player.hideBossBar(existing);
+            return false;
+        }
+
+        final BossBar bar = BossBar.bossBar(Component.empty(), 1.0F, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
+        try {
+            updateTps(player, bar);
+        } catch (final Throwable ignored) {
+            // The refresh loop will populate the bar shortly.
+        }
+        player.showBossBar(bar);
+        TPS_BARS.put(id, bar);
+        ensureThread();
+        return true;
+    }
+
+    /**
+     * Toggles the RAM usage bar for the given player.
+     *
+     * @param player the player to toggle the bar for
+     * @return {@code true} if the bar is now shown, {@code false} if it was hidden
+     */
+    public static boolean toggleRam(final Player player) {
+        final UUID id = player.getUniqueId();
+        final BossBar existing = RAM_BARS.remove(id);
+        if (existing != null) {
+            player.hideBossBar(existing);
+            return false;
+        }
+
+        final BossBar bar = BossBar.bossBar(Component.empty(), 1.0F, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
+        try {
+            updateRam(player, bar);
+        } catch (final Throwable ignored) {
+            // The refresh loop will populate the bar shortly.
+        }
+        player.showBossBar(bar);
+        RAM_BARS.put(id, bar);
+        ensureThread();
+        return true;
+    }
+
+    private static synchronized void ensureThread() {
+        if (updateThread != null) {
+            return;
+        }
+        final Thread thread = new Thread(ServerStatusBars::runLoop, "SilkMC Status Bars");
+        thread.setDaemon(true);
+        updateThread = thread;
+        thread.start();
+    }
+
+    private static void runLoop() {
+        for (;;) {
+            try {
+                Thread.sleep(REFRESH_INTERVAL_MS);
+            } catch (final InterruptedException ignored) {
+                return;
+            }
+
+            final MinecraftServer server = MinecraftServer.getServer();
+            if (server == null || server.hasStopped()) {
+                continue;
+            }
+
+            final Set<UUID> ids = new HashSet<>(TPS_BARS.keySet());
+            ids.addAll(RAM_BARS.keySet());
+
+            for (final UUID id : ids) {
+                final Player player = Bukkit.getPlayer(id);
+                if (player == null || !player.isOnline()) {
+                    final BossBar tps = TPS_BARS.remove(id);
+                    final BossBar ram = RAM_BARS.remove(id);
+                    if (player != null) {
+                        if (tps != null) {
+                            player.hideBossBar(tps);
+                        }
+                        if (ram != null) {
+                            player.hideBossBar(ram);
+                        }
+                    }
+                    continue;
+                }
+                try {
+                    final BossBar tps = TPS_BARS.get(id);
+                    if (tps != null) {
+                        updateTps(player, tps);
+                    }
+                    final BossBar ram = RAM_BARS.get(id);
+                    if (ram != null) {
+                        updateRam(player, ram);
+                    }
+                } catch (final Throwable ignored) {
+                    // Never let a single player's failure stop the refresh loop.
+                }
+            }
+        }
+    }
+
+    private static void updateTps(final Player player, final BossBar bar) {
+        final long now = System.nanoTime();
+
+        double tps = 20.0D;
+        double mspt = 0.0D;
+        final TickData.TickReportData report = tickReportFor(player, now);
+        if (report != null) {
+            tps = report.tpsData().segmentAll().average();
+            mspt = report.timePerTickData().segmentAll().average() / 1.0E6D;
+        }
+        final double clampedTps = Math.max(0.0D, Math.min(20.0D, tps));
+
+        final int ping = player.getPing();
+        bar.name(Component.text()
+            .append(label("TPS: "))
+            .append(value(String.format("%.2f", clampedTps), tpsTextColor(clampedTps)))
+            .append(label(" MSPT: "))
+            .append(value(String.format("%.2f", mspt), msptTextColor(mspt)))
+            .append(label(" Ping: "))
+            .append(value(ping + "ms", pingTextColor(ping)))
+            .build());
+        bar.progress((float) (clampedTps / 20.0D));
+        bar.color(tpsBarColor(clampedTps));
+    }
+
+    private static void updateRam(final Player player, final BossBar bar) {
+        final Runtime runtime = Runtime.getRuntime();
+        final long maxBytes = runtime.maxMemory();
+        final long usedBytes = runtime.totalMemory() - runtime.freeMemory();
+        final long usedMb = Math.round(usedBytes / MB);
+        final long maxMb = Math.round(maxBytes / MB);
+        final int percent = maxMb <= 0L ? 0 : (int) Math.round((usedMb * 100.0D) / maxMb);
+
+        bar.name(Component.text()
+            .append(label("Ram: "))
+            .append(value(usedMb + "/" + maxMb, ramTextColor(percent)))
+            .append(label(" (" + percent + "%)"))
+            .build());
+        bar.progress(clamp01((float) percent / 100.0F));
+        bar.color(ramBarColor(percent));
+    }
+
+    private static TickData.TickReportData tickReportFor(final Player player, final long now) {
+        try {
+            final ServerLevel level = ((CraftWorld) player.getWorld()).getHandle();
+            final int chunkX = player.getLocation().getBlockX() >> 4;
+            final int chunkZ = player.getLocation().getBlockZ() >> 4;
+            final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+                level.regioniser.getRegionAtSynchronised(chunkX, chunkZ);
+            if (region != null) {
+                return region.getData().getRegionSchedulingHandle().getTickReport5s(now);
+            }
+        } catch (final Throwable ignored) {
+            // Fall through to the global tick data below.
+        }
+        try {
+            return RegionizedServer.getGlobalTickData().getTickReport5s(now);
+        } catch (final Throwable ignored) {
+            return null;
+        }
+    }
+
+    private static float clamp01(final float value) {
+        return Math.max(0.0F, Math.min(1.0F, value));
+    }
+
+    private static Component label(final String text) {
+        return Component.text(text, NamedTextColor.YELLOW, TextDecoration.BOLD);
+    }
+
+    private static Component value(final String text, final TextColor color) {
+        return Component.text(text, color, TextDecoration.BOLD);
+    }
+
+    private static TextColor pingTextColor(final int ping) {
+        if (ping < 100) {
+            return NamedTextColor.GREEN;
+        }
+        if (ping < 250) {
+            return NamedTextColor.YELLOW;
+        }
+        return NamedTextColor.RED;
+    }
+
+    private static TextColor tpsTextColor(final double tps) {
+        if (tps >= 18.0D) {
+            return NamedTextColor.GREEN;
+        }
+        if (tps >= 15.0D) {
+            return NamedTextColor.YELLOW;
+        }
+        return NamedTextColor.RED;
+    }
+
+    private static BossBar.Color tpsBarColor(final double tps) {
+        if (tps >= 18.0D) {
+            return BossBar.Color.GREEN;
+        }
+        if (tps >= 15.0D) {
+            return BossBar.Color.YELLOW;
+        }
+        return BossBar.Color.RED;
+    }
+
+    private static TextColor msptTextColor(final double mspt) {
+        if (mspt <= 35.0D) {
+            return NamedTextColor.GREEN;
+        }
+        if (mspt <= 50.0D) {
+            return NamedTextColor.YELLOW;
+        }
+        return NamedTextColor.RED;
+    }
+
+    private static TextColor ramTextColor(final int percent) {
+        if (percent < 70) {
+            return NamedTextColor.GREEN;
+        }
+        if (percent < 85) {
+            return NamedTextColor.YELLOW;
+        }
+        return NamedTextColor.RED;
+    }
+
+    private static BossBar.Color ramBarColor(final int percent) {
+        if (percent < 70) {
+            return BossBar.Color.GREEN;
+        }
+        if (percent < 85) {
+            return BossBar.Color.YELLOW;
+        }
+        return BossBar.Color.RED;
+    }
+}
