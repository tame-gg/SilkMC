+package gg.tame.silkmc.server.bars;
+
+import ca.spottedleaf.common.time.TickData;
+import com.google.gson.Gson;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.mojang.logging.LogUtils;
+import io.papermc.paper.threadedregions.RegionizedServer;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import java.io.IOException;
+import java.io.Reader;
+import java.io.Writer;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryUsage;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Consumer;
+import net.kyori.adventure.bossbar.BossBar;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.minimessage.MiniMessage;
+import net.kyori.adventure.text.minimessage.tag.resolver.Placeholder;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.entity.Entity;
+import org.bukkit.Bukkit;
+import org.bukkit.craftbukkit.entity.CraftEntity;
+import org.bukkit.entity.Player;
+import org.slf4j.Logger;
+
+/**
+ * Renders live server-health boss bars for players who opt in through {@code /tpsbar} and
+ * {@code /rambar}. Each bar is toggled independently: the TPS bar shows TPS/MSPT/ping and the
+ * RAM bar shows heap usage.
+ *
+ * <p>The bar text, gradient colors, thresholds and byte formatting mirror
+ * <a href="https://github.com/SerlithNetwork/PurpurBars">SerlithNetwork/PurpurBars</a> (which in
+ * turn mirrors Purpur's TPS/RAM bars) so the look matches that project's defaults.
+ *
+ * <p>Per-player opt-in state is persisted to disk ({@code silkmc-status-bars.json}) so that a
+ * player's enabled bars survive disconnect/reconnect and full server restarts. This is intended as
+ * a lightweight testing/observability aid.
+ *
+ * <h2>Threading</h2>
+ *
+ * <p>Everything that reads or writes game state runs on the region thread that owns the player it
+ * is about. Each tracked player drives their own refresh loop through the player's
+ * {@link io.papermc.paper.threadedregions.EntityScheduler}, re-arming itself every
+ * {@link #REFRESH_INTERVAL_TICKS} ticks; the scheduler follows the player across region splits,
+ * merges and dimension changes, and retires the loop when the player disconnects. Toggles from
+ * {@code /tpsbar} and {@code /rambar} are funnelled onto the same thread, so the transient bar maps
+ * below are only ever mutated by the owning region and cannot race.
+ *
+ * <p>A single daemon supervisor thread ticks once per second, but it touches no game state at all:
+ * it only hands a task to the global region, which is the owner of the player list and may
+ * therefore enumerate online players and arm a refresh loop for anyone who has opted in but is not
+ * currently running one (a player who just joined, or whose loop was retired).
+ */
+public final class ServerStatusBars {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final Gson GSON = new Gson();
+    private static final String DATA_FILE_NAME = "silkmc-status-bars.json";
+    private static final MiniMessage MINI_MESSAGE = MiniMessage.miniMessage();
+
+    private static final long REFRESH_INTERVAL_TICKS = 20L;
+    private static final long SUPERVISOR_INTERVAL_MS = 1000L;
+
+    // Title templates and gradient text colors, matching PurpurBars' default config.
+    private static final String TPS_TITLE = "<gray>TPS<yellow>:</yellow> <tps> MSPT<yellow>:</yellow> <mspt> Ping<yellow>:</yellow> <ping>ms";
+    private static final String RAM_TITLE = "<gray>Ram<yellow>:</yellow> <used>/<xmx> (<percent>)";
+    static final String COLOR_GOOD = "<gradient:#55ff55:#00aa00><text></gradient>";
+    static final String COLOR_MEDIUM = "<gradient:#ffff55:#ffaa00><text></gradient>";
+    static final String COLOR_LOW = "<gradient:#ff5555:#aa0000><text></gradient>";
+    private static final char[] BYTE_UNITS = {'B', 'K', 'M', 'G', 'T', 'P', 'E'};
+
+    // Persisted opt-in state: which players want each bar. Survives reconnects and restarts.
+    private static final Set<UUID> TPS_ENABLED = ConcurrentHashMap.newKeySet();
+    private static final Set<UUID> RAM_ENABLED = ConcurrentHashMap.newKeySet();
+
+    // Transient boss bars currently shown to online players; rebuilt on (re)join. Only mutated from
+    // the region thread that owns the player each entry belongs to.
+    private static final Map<UUID, BossBar> TPS_BARS = new ConcurrentHashMap<>();
+    private static final Map<UUID, BossBar> RAM_BARS = new ConcurrentHashMap<>();
+
+    // Players that currently have a self-rearming refresh loop on their entity scheduler.
+    private static final Set<UUID> ACTIVE_LOOPS = ConcurrentHashMap.newKeySet();
+
+    private static final Object IO_LOCK = new Object();
+    private static volatile ScheduledExecutorService supervisor;
+    private static volatile boolean loaded;
+    private static Path dataFile; // Guarded by IO_LOCK.
+
+    private ServerStatusBars() {
+    }
+
+    /**
+     * Loads persisted opt-in state and starts the refresher. Invoked once during server startup
+     * (from command registration), so persisted bars are restored on every reboot.
+     */
+    public static void init() {
+        load();
+        ensureSupervisor();
+    }
+
+    /**
+     * Toggles the TPS/MSPT/ping bar for the given player and persists the change.
+     *
+     * @param player the player to toggle the bar for
+     * @return {@code true} if the bar is now shown, {@code false} if it was hidden
+     */
+    public static boolean toggleTps(final Player player) {
+        final boolean enabled = toggle(player, TPS_ENABLED, TPS_BARS, ServerStatusBars::showTps);
+        save();
+        return enabled;
+    }
+
+    /**
+     * Toggles the RAM usage bar for the given player and persists the change.
+     *
+     * @param player the player to toggle the bar for
+     * @return {@code true} if the bar is now shown, {@code false} if it was hidden
+     */
+    public static boolean toggleRam(final Player player) {
+        final boolean enabled = toggle(player, RAM_ENABLED, RAM_BARS, ServerStatusBars::showRam);
+        save();
+        return enabled;
+    }
+
+    private interface BarRenderer {
+        void show(Player player);
+    }
+
+    private static boolean toggle(final Player player, final Set<UUID> enabled, final Map<UUID, BossBar> bars, final BarRenderer renderer) {
+        final UUID id = player.getUniqueId();
+        final boolean nowEnabled = !enabled.remove(id);
+        if (nowEnabled) {
+            enabled.add(id);
+        }
+
+        // The opt-in sets above are concurrent and safe to flip from here, but showing or hiding the
+        // bar touches the player, so hand that to the region that owns them. When the command is
+        // already running on that region (the normal case) this executes inline.
+        onOwningThread(player, entity -> {
+            if (!(entity.getBukkitEntity() instanceof final Player owned)) {
+                return;
+            }
+            if (nowEnabled) {
+                renderer.show(owned);
+                ensureLoop(owned, id);
+            } else {
+                hide(owned, bars, id);
+            }
+        });
+
+        ensureSupervisor();
+        return nowEnabled;
+    }
+
+    /**
+     * Runs {@code action} on the region thread that owns {@code player}, immediately if the caller
+     * already owns it. Never blocks and never touches the player from the calling thread.
+     */
+    private static void onOwningThread(final Player player, final Consumer<Entity> action) {
+        try {
+            ((CraftEntity) player).taskScheduler.scheduleOrExecute(action);
+        } catch (final Throwable throwable) {
+            LOGGER.warn("Failed to schedule a SilkMC status bar update for {}", player.getUniqueId(), throwable);
+        }
+    }
+
+    private static synchronized void ensureSupervisor() {
+        if (supervisor != null) {
+            return;
+        }
+        final ScheduledExecutorService executor = Executors.newSingleThreadScheduledExecutor(runnable -> {
+            final Thread thread = new Thread(runnable, "SilkMC Status Bars Supervisor");
+            thread.setDaemon(true);
+            return thread;
+        });
+        supervisor = executor;
+        executor.scheduleWithFixedDelay(
+            ServerStatusBars::pumpSupervisor,
+            SUPERVISOR_INTERVAL_MS,
+            SUPERVISOR_INTERVAL_MS,
+            TimeUnit.MILLISECONDS
+        );
+    }
+
+    /**
+     * Runs on the supervisor thread, which owns no region: it may not read any game state, only hand
+     * work to the global region.
+     */
+    private static void pumpSupervisor() {
+        try {
+            final MinecraftServer server = MinecraftServer.getServer();
+            if (server == null || server.hasStopped()) {
+                return;
+            }
+            if (TPS_ENABLED.isEmpty() && RAM_ENABLED.isEmpty()) {
+                return;
+            }
+            RegionizedServer.getInstance().addTask(ServerStatusBars::armMissingLoops);
+        } catch (final Throwable throwable) {
+            LOGGER.warn("Failed to schedule the SilkMC status bar sweep", throwable);
+        }
+    }
+
+    /**
+     * Runs on the global region, which owns the player list. Starts a refresh loop for every opted-in
+     * player that does not have one yet, which is how bars come back after a join or reconnect.
+     */
+    private static void armMissingLoops() {
+        try {
+            for (final Player player : Bukkit.getOnlinePlayers()) {
+                final UUID id = player.getUniqueId();
+                if (TPS_ENABLED.contains(id) || RAM_ENABLED.contains(id)) {
+                    ensureLoop(player, id);
+                }
+            }
+        } catch (final Throwable throwable) {
+            LOGGER.warn("Failed to sweep SilkMC status bars", throwable);
+        }
+    }
+
+    private static void ensureLoop(final Player player, final UUID id) {
+        if (!ACTIVE_LOOPS.add(id)) {
+            return;
+        }
+        if (!scheduleRefresh(player, id, 1L)) {
+            ACTIVE_LOOPS.remove(id);
+        }
+    }
+
+    private static boolean scheduleRefresh(final Player player, final UUID id, final long delayTicks) {
+        try {
+            return ((CraftEntity) player).taskScheduler.schedule(
+                (final Entity entity) -> refresh(entity, id),
+                (final Entity entity) -> forget(id),
+                delayTicks
+            );
+        } catch (final Throwable throwable) {
+            LOGGER.warn("Failed to schedule the SilkMC status bar refresh for {}", id, throwable);
+            return false;
+        }
+    }
+
+    /**
+     * One refresh tick for a single player, invoked by that player's entity scheduler and therefore
+     * on the region thread that owns them. Re-arms itself while the player still wants a bar.
+     */
+    private static void refresh(final Entity entity, final UUID id) {
+        Player player = null;
+        try {
+            if (!(entity.getBukkitEntity() instanceof final Player online) || !online.isOnline()) {
+                forget(id);
+                return;
+            }
+
+            final boolean wantsTps = TPS_ENABLED.contains(id);
+            final boolean wantsRam = RAM_ENABLED.contains(id);
+            if (!wantsTps && !wantsRam) {
+                hide(online, TPS_BARS, id);
+                hide(online, RAM_BARS, id);
+                ACTIVE_LOOPS.remove(id);
+                return;
+            }
+
+            if (wantsTps) {
+                showTps(online);
+            } else {
+                hide(online, TPS_BARS, id);
+            }
+            if (wantsRam) {
+                showRam(online);
+            } else {
+                hide(online, RAM_BARS, id);
+            }
+            player = online;
+        } catch (final Throwable throwable) {
+            LOGGER.warn("Failed to refresh SilkMC status bars for {}", id, throwable);
+        }
+
+        // On any failure the loop stops here; the supervisor re-arms it on its next sweep.
+        if (player == null || !scheduleRefresh(player, id, REFRESH_INTERVAL_TICKS)) {
+            ACTIVE_LOOPS.remove(id);
+        }
+    }
+
+    // Drops all transient state for a player who is gone. Their opt-in is deliberately kept so the
+    // bars come back on reconnect.
+    private static void forget(final UUID id) {
+        ACTIVE_LOOPS.remove(id);
+        TPS_BARS.remove(id);
+        RAM_BARS.remove(id);
+    }
+
+    private static void hide(final Player player, final Map<UUID, BossBar> bars, final UUID id) {
+        final BossBar bar = bars.remove(id);
+        if (bar != null) {
+            player.hideBossBar(bar);
+        }
+    }
+
+    private static void showTps(final Player player) {
+        final UUID id = player.getUniqueId();
+        BossBar bar = TPS_BARS.get(id);
+        if (bar == null) {
+            bar = BossBar.bossBar(Component.empty(), 0.0F, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
+            player.showBossBar(bar);
+            TPS_BARS.put(id, bar);
+        }
+        updateTps(player, bar);
+    }
+
+    private static void showRam(final Player player) {
+        final UUID id = player.getUniqueId();
+        BossBar bar = RAM_BARS.get(id);
+        if (bar == null) {
+            bar = BossBar.bossBar(Component.empty(), 0.0F, BossBar.Color.GREEN, BossBar.Overlay.PROGRESS);
+            player.showBossBar(bar);
+            RAM_BARS.put(id, bar);
+        }
+        updateRam(player, bar);
+    }
+
+    private static void updateTps(final Player player, final BossBar bar) {
+        final long now = System.nanoTime();
+
+        double tps = 20.0D;
+        double mspt = 0.0D;
+        final TickData.TickReportData report = currentTickReport(now);
+        if (report != null) {
+            tps = Math.clamp(report.tpsData().segmentAll().average(), 0.0D, 20.0D);
+            mspt = Math.max(0.0D, report.timePerTickData().segmentAll().average() / 1.0E6D);
+        }
+        final int ping = player.getPing();
+
+        // Progress + bar color follow PurpurBars' default MSPT fill mode.
+        bar.progress(clamp01((float) (mspt / 50.0D)));
+        bar.color(tpsBarColor(mspt));
+        bar.name(MINI_MESSAGE.deserialize(TPS_TITLE,
+            Placeholder.component("tps", coloredValue(tpsTier(tps), String.format("%.2f", tps))),
+            Placeholder.component("mspt", coloredValue(msptTier(mspt), String.format("%.2f", mspt))),
+            Placeholder.component("ping", coloredValue(pingTier(ping), String.format("%d", ping)))));
+    }
+
+    private static void updateRam(final Player player, final BossBar bar) {
+        final MemoryUsage heap = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
+        final long used = heap.getUsed();
+        final long xmx = heap.getMax();
+        final float percent = xmx <= 0L ? 0.0F : clamp01((float) ((double) used / xmx));
+        final String tier = ramTier(percent);
+
+        bar.progress(percent);
+        bar.color(ramBarColor(percent));
+        bar.name(MINI_MESSAGE.deserialize(RAM_TITLE,
+            Placeholder.component("used", coloredValue(tier, formatBytes(used))),
+            Placeholder.component("xmx", coloredValue(tier, formatBytes(xmx))),
+            Placeholder.parsed("percent", String.format("%d%%", (int) (percent * 100)))));
+    }
+
+    private static Component coloredValue(final String tierTemplate, final String text) {
+        return MINI_MESSAGE.deserialize(tierTemplate, Placeholder.unparsed("text", text));
+    }
+
+    /**
+     * Tick data for the region currently being ticked, falling back to the global region schedule.
+     *
+     * <p>Callers are already running on the region that owns the player the bar belongs to, so the
+     * region being ticked <i>is</i> that player's region: there is no need to look the player's
+     * position up in the regioniser, and no window in which they could have moved to another one.
+     */
+    private static TickData.TickReportData currentTickReport(final long now) {
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+            TickRegionScheduler.getCurrentRegion();
+        if (region != null) {
+            final TickData.TickReportData report = region.getData().getRegionSchedulingHandle().getTickReport5s(now);
+            if (report != null) {
+                return report;
+            }
+        }
+        try {
+            return RegionizedServer.getGlobalTickData().getTickReport5s(now);
+        } catch (final Throwable ignored) {
+            return null;
+        }
+    }
+
+    /**
+     * The opt-in file, resolved against the server directory rather than the process working
+     * directory: a bare relative path puts the file wherever the server happened to be launched
+     * from, so starting it from elsewhere silently loses everyone's opt-in.
+     *
+     * <p>Must be called while holding {@link #IO_LOCK}.
+     */
+    private static Path dataFile() {
+        Path resolved = dataFile;
+        if (resolved == null) {
+            final MinecraftServer server = MinecraftServer.getServer();
+            resolved = server == null ? Path.of(DATA_FILE_NAME) : server.getServerDirectory().resolve(DATA_FILE_NAME);
+            dataFile = resolved;
+        }
+        return resolved;
+    }
+
+    private static void load() {
+        synchronized (IO_LOCK) {
+            if (loaded) {
+                return;
+            }
+            loaded = true;
+            final Path source = dataFile();
+            if (!Files.exists(source)) {
+                return;
+            }
+            try (Reader reader = Files.newBufferedReader(source, StandardCharsets.UTF_8)) {
+                final JsonObject root = GSON.fromJson(reader, JsonObject.class);
+                if (root == null) {
+                    return;
+                }
+                readInto(root, "tps", TPS_ENABLED);
+                readInto(root, "ram", RAM_ENABLED);
+            } catch (final Exception exception) {
+                LOGGER.warn("Failed to load persisted SilkMC status bars from {}", source, exception);
+            }
+        }
+    }
+
+    private static void save() {
+        synchronized (IO_LOCK) {
+            final Path target = dataFile();
+            final JsonObject root = new JsonObject();
+            root.add("tps", toArray(TPS_ENABLED));
+            root.add("ram", toArray(RAM_ENABLED));
+
+            // Write beside the target and move it into place, so that losing the process partway
+            // through cannot leave a truncated file behind. Gson writing straight into the target
+            // would, and a half-written file does not parse, which silently drops every player's
+            // opt-in rather than just the toggle that was in flight.
+            final Path temporary = target.resolveSibling(DATA_FILE_NAME + ".tmp");
+            try {
+                try (Writer writer = Files.newBufferedWriter(temporary, StandardCharsets.UTF_8)) {
+                    GSON.toJson(root, writer);
+                }
+                try {
+                    Files.move(temporary, target, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+                } catch (final AtomicMoveNotSupportedException ex) {
+                    Files.move(temporary, target, StandardCopyOption.REPLACE_EXISTING);
+                }
+            } catch (final IOException exception) {
+                LOGGER.warn("Failed to save SilkMC status bars to {}", target, exception);
+                try {
+                    Files.deleteIfExists(temporary);
+                } catch (final IOException ignored) {
+                    // Nothing useful to do; the next save overwrites it.
+                }
+            }
+        }
+    }
+
+    private static JsonArray toArray(final Set<UUID> ids) {
+        final JsonArray array = new JsonArray();
+        for (final UUID id : ids) {
+            array.add(id.toString());
+        }
+        return array;
+    }
+
+    private static void readInto(final JsonObject root, final String key, final Set<UUID> target) {
+        if (!root.has(key) || !root.get(key).isJsonArray()) {
+            return;
+        }
+        for (final JsonElement element : root.getAsJsonArray(key)) {
+            try {
+                target.add(UUID.fromString(element.getAsString()));
+            } catch (final RuntimeException ignored) {
+                // Skip malformed entries.
+            }
+        }
+    }
+
+    static float clamp01(final float value) {
+        return Math.max(0.0F, Math.min(1.0F, value));
+    }
+
+    static String tpsTier(final double tps) {
+        if (tps >= 19.0D) {
+            return COLOR_GOOD;
+        }
+        if (tps >= 15.0D) {
+            return COLOR_MEDIUM;
+        }
+        return COLOR_LOW;
+    }
+
+    static String msptTier(final double mspt) {
+        if (mspt < 40.0D) {
+            return COLOR_GOOD;
+        }
+        if (mspt < 50.0D) {
+            return COLOR_MEDIUM;
+        }
+        return COLOR_LOW;
+    }
+
+    static String pingTier(final int ping) {
+        if (ping < 100) {
+            return COLOR_GOOD;
+        }
+        if (ping < 200) {
+            return COLOR_MEDIUM;
+        }
+        return COLOR_LOW;
+    }
+
+    static String ramTier(final float percent) {
+        if (percent < 0.6F) {
+            return COLOR_GOOD;
+        }
+        if (percent < 0.85F) {
+            return COLOR_MEDIUM;
+        }
+        return COLOR_LOW;
+    }
+
+    static BossBar.Color tpsBarColor(final double mspt) {
+        if (mspt < 40.0D) {
+            return BossBar.Color.GREEN;
+        }
+        if (mspt < 50.0D) {
+            return BossBar.Color.YELLOW;
+        }
+        return BossBar.Color.RED;
+    }
+
+    static BossBar.Color ramBarColor(final float percent) {
+        if (percent < 0.5F) {
+            return BossBar.Color.GREEN;
+        }
+        if (percent < 0.75F) {
+            return BossBar.Color.YELLOW;
+        }
+        return BossBar.Color.RED;
+    }
+
+    // Mirrors PurpurBars' Utils.formatBytes: base-1024 units, whole numbers up to and including M
+    // ("512M", "1M"), one decimal place from G upwards ("3.9G"). A heap bar is almost always in the
+    // decimal range, which is the part that was matched against reference output.
+    static String formatBytes(final long bytes) {
+        if (bytes < 1024L) {
+            return String.format("%dB", bytes);
+        }
+        final int z = (63 - Long.numberOfLeadingZeros(bytes)) / 10;
+        if (z > 2) {
+            return String.format("%.1f%c", ((float) bytes) / (1L << (z * 10)), BYTE_UNITS[z]);
+        }
+        return String.format("%d%c", bytes / (1L << (z * 10)), BYTE_UNITS[z]);
+    }
+}
