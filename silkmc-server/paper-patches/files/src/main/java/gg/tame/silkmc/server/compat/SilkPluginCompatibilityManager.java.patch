+    private record Decision(boolean blocked, boolean logWarning, String warningMessage, String failureMessage) {
+    }
+
+    /** Accumulates what a jar's bytecode actually refers to. Not thread-safe; scanned serially. */
+    static final class Signals {
+        int scannedClasses;
+        int unreadableClasses;
+        boolean craftBukkit;
+        boolean nms;
+        boolean defeatsThreadChecks;
+        boolean assumesMainThread;
+        boolean legacyScheduler;
+
+        /** Records a reference to an internal class name, which may be an array descriptor. */
+        void type(final String internalName) {
+            if (internalName == null || internalName.isEmpty()) {
+                return;
+            }
+            if (internalName.charAt(0) == '[') {
+                this.descriptor(internalName);
+                return;
+            }
+            this.flag(internalName);
+        }
+
+        /** Records every object type mentioned by a field or method descriptor. */
+        void descriptor(final String descriptor) {
+            if (descriptor == null || descriptor.isEmpty()) {
+                return;
+            }
+            if (descriptor.charAt(0) == '(') {
+                for (final Type argument : Type.getArgumentTypes(descriptor)) {
+                    this.objectType(argument);
+                }
+                this.objectType(Type.getReturnType(descriptor));
+            } else {
+                this.objectType(Type.getType(descriptor));
+            }
+        }
+
+        /** Records a call by owner and name, for the APIs whose <em>use</em> is the signal. */
+        void call(final String owner, final String name) {
+            if (owner == null || !owner.startsWith("org/bukkit/")) {
+                return;
+            }
+            switch (name) {
+                case "isPrimaryThread" -> this.assumesMainThread = true;
+                case "scheduleSyncDelayedTask", "scheduleSyncRepeatingTask", "callSyncMethod" -> this.legacyScheduler = true;
+                default -> {
+                }
+            }
+        }
+
+        private void objectType(final Type type) {
+            final Type element = type.getSort() == Type.ARRAY ? type.getElementType() : type;
+            if (element.getSort() == Type.OBJECT) {
+                this.flag(element.getInternalName());
+            }
+        }
+
+        private void flag(final String internalName) {
+            if (internalName.startsWith("org/bukkit/craftbukkit/")) {
+                this.craftBukkit = true;
+            } else if (internalName.startsWith("net/minecraft/") || internalName.startsWith("com/mojang/brigadier/")) {
+                this.nms = true;
+            } else if (internalName.equals("org/spigotmc/AsyncCatcher")) {
+                this.defeatsThreadChecks = true;
+            }
+        }
+    }
+
+    /** Feeds every type and call reference in a class into a {@link Signals}. */
+    static final class ReferenceScanner extends ClassVisitor {
+
+        private final Signals signals;
+        private final MethodVisitor methodScanner;
+
+        ReferenceScanner(final Signals signals) {
+            super(Opcodes.ASM9);
+            this.signals = signals;
+            this.methodScanner = new MethodVisitor(Opcodes.ASM9) {
+                @Override
+                public void visitTypeInsn(final int opcode, final String type) {
+                    signals.type(type);
+                }
+
+                @Override
+                public void visitFieldInsn(final int opcode, final String owner, final String name, final String descriptor) {
+                    signals.type(owner);
+                    signals.descriptor(descriptor);
+                }
+
+                @Override
+                public void visitMethodInsn(final int opcode, final String owner, final String name, final String descriptor, final boolean isInterface) {
+                    signals.type(owner);
+                    signals.descriptor(descriptor);
+                    signals.call(owner, name);
+                }
+            };
+        }
+
+        @Override
+        public void visit(final int version, final int access, final String name, final String signature, final String superName, final String[] interfaces) {
+            this.signals.type(superName);
+            if (interfaces != null) {
+                for (final String implemented : interfaces) {
+                    this.signals.type(implemented);
+                }
+            }
+        }
+
+        @Override
+        public FieldVisitor visitField(final int access, final String name, final String descriptor, final String signature, final Object value) {
+            this.signals.descriptor(descriptor);
+            return null;
+        }
+
+        @Override
+        public MethodVisitor visitMethod(final int access, final String name, final String descriptor, final String signature, final String[] exceptions) {
+            this.signals.descriptor(descriptor);
+            return this.methodScanner;
+        }
+    }
+
+    public record RegionStatus(int regionCount, double worstRegionMspt) {
+    }
+
+    public record Summary(int safe, int compatible, int unknown, int unsafe, int shimmed) {
+    }
+
+    public record Report(
+        String pluginName,
+        String version,
+        Classification classification,
+        String family,
+        boolean shimActive,
+        NmsAccessLevel nmsAccessLevel,
+        int scannedClassCount,
+        boolean overrideApplied,
+        boolean forceLoad,
+        String overrideReason,
+        List<String> reasons,
+        List<String> technicalDetails
+    ) {
+        public Report {
+            reasons = reasons == null ? List.of() : List.copyOf(reasons);
+            technicalDetails = technicalDetails == null ? List.of() : List.copyOf(technicalDetails);
+        }
+    }
+
+    public enum Classification {
+        SAFE,
+        COMPATIBLE,
+        UNKNOWN,
+        UNSAFE
+    }
+
+    public enum NmsAccessLevel {
+        NONE,
+        CRAFTBUKKIT,
+        NMS
+    }
+}
