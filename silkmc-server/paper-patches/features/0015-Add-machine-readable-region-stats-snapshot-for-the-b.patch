         this.setPermission("silkmc.command");
         final var pluginManager = Bukkit.getPluginManager();
         if (pluginManager.getPermission("silkmc.command") == null) {
@@ -35,6 +35,18 @@ public final class SilkMCCommand extends Command {
         }
     }
 
+    /**
+     * Dumps a machine-readable snapshot of region tick statistics for the benchmark harness in
+     * {@code tools/benchmark}. Read-only: every figure is already maintained by the tick loop, so this
+     * adds no per-tick cost. See {@link RegionStatsSnapshot}.
+     */
+    private boolean executeBench(final CommandSender sender) {
+        for (final String line : RegionStatsSnapshot.render()) {
+            sender.sendMessage(Component.text(line));
+        }
+        return true;
+    }
+
     @Override
     public boolean execute(final CommandSender sender, final String commandLabel, final String[] args) {
         if (!this.testPermission(sender)) {
@@ -50,6 +62,7 @@ public final class SilkMCCommand extends Command {
             case "plugins" -> this.executePlugins(sender, args);
             case "report" -> this.executeReport(sender, args);
             case "reload" -> this.executeReload(sender);
+            case "bench" -> this.executeBench(sender);
             default -> {
                 sender.sendMessage(Component.text("Usage: " + this.usageMessage, NamedTextColor.RED));
                 yield false;
